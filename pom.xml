<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.argonathsystems</groupId>
        <artifactId>argonath-mithril-forge-core</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../01-platform-core/pom.xml</relativePath>
    </parent>

    <groupId>com.argonathsystems.adapter</groupId>
    <artifactId>argonath-gandalfs-bridge-adapter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Hytale Adapter</name>
    <description>A LordOfTheTales adapter</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <hytale.version>1.0-SNAPSHOT</hytale.version>
    </properties>

    <dependencies>
        <!-- =====================================================
             HYTALE SERVER API
             ✅ THIS IS THE ONLY MODULE THAT CAN IMPORT HYTALE
             ===================================================== -->
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>HytaleServer-parent</artifactId>
            <version>${hytale.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- =====================================================
             FRAMEWORK DEPENDENCIES (implements these interfaces)
             ===================================================== -->
        
        <!-- Accessor API - Interfaces to implement -->
        <dependency>
            <groupId>com.argonathsystems.framework</groupId>
            <artifactId>argonath-grey-havens-accessor</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Core Library - Shared utilities -->
        <dependency>
            <groupId>com.argonathsystems.framework</groupId>
            <artifactId>argonath-bag-end-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- HyQuest API Client - For Quest Designer integration -->
        <dependency>
            <groupId>com.argonathsystems.lib</groupId>
            <artifactId>hyquest-api-client</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        
        <!-- Quest Framework - To convert between formats -->
        <dependency>
            <groupId>com.argonathsystems.framework</groupId>
            <artifactId>argonath-fellowship-quest</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>        
        <!-- Javalin - Lightweight HTTP framework for REST API -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.1.3</version>
        </dependency>
        
        <!-- SLF4J Simple Logger for Javalin -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
        </dependency>
        
        <!-- Gson for JSON serialization (used by HyQuestApiService) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <!-- =====================================================
             TEST DEPENDENCIES
             ===================================================== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Surefire Plugin for tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>



            <!-- Source JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>

            <!-- JavaDoc JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>