package com.argonathsystems.adapter.hytale.ui;

import com.hypixel.hytale.server.core.universe.PlayerRef;
import com.hytale.api.entity.Player;

import java.util.Optional;

/**
 * Resolves a Hytale Player to a PlayerRef for HyUI operations.
 * 
 * <p>This interface abstracts the mechanism by which we obtain a PlayerRef
 * from a Player instance. The implementation may vary depending on
 * how the Hytale server manages player references.
 * 
 * @author Argonath Systems
 * @version 1.0.0-SNAPSHOT
 * @since 1.0.0
 */
@FunctionalInterface
public interface PlayerRefResolver {
    
    /**
     * Resolve a Player to a PlayerRef.
     * 
     * @param player The player to resolve
     * @return The PlayerRef, or empty if resolution failed
     */
    Optional<PlayerRef> resolve(Player player);
}
