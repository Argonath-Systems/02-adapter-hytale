package com.argonathsystems.adapter.hytale.ui;

import com.argonathsystems.adapter.hytaleadapter.util.PlayerRefCache;
import com.hypixel.hytale.server.core.universe.PlayerRef;
import com.hytale.api.entity.Player;

import java.util.Optional;

/**
 * Default implementation of PlayerRefResolver using the PlayerRefCache.
 * 
 * @author Argonath Systems
 * @version 1.0.0-SNAPSHOT
 * @since 1.0.0
 */
public class DefaultPlayerRefResolver implements PlayerRefResolver {
    
    private static final DefaultPlayerRefResolver INSTANCE = new DefaultPlayerRefResolver();
    
    private DefaultPlayerRefResolver() {}
    
    /**
     * Get the singleton instance.
     * 
     * @return The default resolver instance
     */
    public static DefaultPlayerRefResolver getInstance() {
        return INSTANCE;
    }
    
    @Override
    public Optional<PlayerRef> resolve(Player player) {
        if (player == null) {
            return Optional.empty();
        }
        
        // Use the existing PlayerRefCache to get the PlayerRef
        PlayerRef ref = PlayerRefCache.getRef(player.getUUID());
        return Optional.ofNullable(ref);
    }
}
