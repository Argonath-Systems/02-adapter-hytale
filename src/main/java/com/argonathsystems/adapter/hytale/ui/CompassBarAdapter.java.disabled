package com.argonathsystems.adapter.hytale.ui;

import au.ellie.hyui.builders.HudBuilder;
import au.ellie.hyui.builders.HyUIHud;
import au.ellie.hyui.html.TemplateProcessor;
import com.hypixel.hytale.protocol.packets.interface_.CustomUIEventBindingType;
import com.hypixel.hytale.server.core.universe.PlayerRef;
import com.hytale.api.entity.Player;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;
import java.util.function.Consumer;

/**
 * Adapter for compass bar HUD element.
 * 
 * <p>This adapter bridges the platform-agnostic compass data
 * with the Hytale platform's UI system.
 * 
 * <p><b>Architecture:</b>
 * <ul>
 *   <li>CompassData → TemplateProcessor → HYUIML → Player UI</li>
 *   <li>Displays directional compass with tracked quest/waypoint</li>
 *   <li>ONLY module in adapter layer</li>
 * </ul>
 * 
 * @author Argonath Systems
 * @version 1.0.0-SNAPSHOT
 * @since 1.0.0
 */
public class CompassBarAdapter {
    
    private static final String COMPASS_BAR_TEMPLATE_PATH = "config/ui/huds/compass-bar.hyuiml";
    private static final long REFRESH_RATE_MS = 50; // 50ms refresh for smooth compass updates
    
    private final TemplateLoader templateLoader;
    private final PlayerRefResolver playerRefResolver;
    private final Map<UUID, HyUIHud> activeHuds = new ConcurrentHashMap<>();
    private Consumer<String> waypointClickHandler;
    
    /**
     * Create a new compass bar adapter.
     * 
     * @param templateLoader Template file loader
     * @param playerRefResolver Resolver to get PlayerRef from Player
     */
    public CompassBarAdapter(TemplateLoader templateLoader, PlayerRefResolver playerRefResolver) {
        this.templateLoader = templateLoader;
        this.playerRefResolver = playerRefResolver;
    }
    
    /**
     * Set the handler for waypoint click events.
     * 
     * @param handler Handler invoked when player clicks a waypoint
     * @return this adapter
     */
    public CompassBarAdapter setWaypointClickHandler(Consumer<String> handler) {
        this.waypointClickHandler = handler;
        return this;
    }
    
    /**
     * Show compass bar HUD for a player.
     * 
     * @param player Player to show compass bar to
     * @param data Compass data to display
     * @return Processed HTML ready for rendering
     */
    public String showCompassBar(Player player, CompassData data) {
        try {
            String template = templateLoader.loadTemplate(COMPASS_BAR_TEMPLATE_PATH);
            String processedHtml = processTemplate(template, data);
            
            // Get PlayerRef for HyUI
            Optional<PlayerRef> playerRefOpt = playerRefResolver.resolve(player);
            if (playerRefOpt.isEmpty()) {
                player.sendMessage("§cError: Could not resolve player reference");
                return processedHtml;
            }
            
            PlayerRef playerRef = playerRefOpt.get();
            UUID playerId = player.getUUID();
            
            // Remove existing HUD if present
            HyUIHud existingHud = activeHuds.get(playerId);
            if (existingHud != null) {
                existingHud.remove();
            }
            
            // Build and show HUD using HyUI
            HudBuilder builder = HudBuilder.hudForPlayer(playerRef)
                .fromHtml(processedHtml)
                .withRefreshRate(REFRESH_RATE_MS);
            
            // Add waypoint click event if handler is set
            if (waypointClickHandler != null) {
                builder.addEventListener("waypoint", CustomUIEventBindingType.Activating, (ctx) -> {
                    waypointClickHandler.accept("waypoint");
                });
                builder.addEventListener("quest-marker", CustomUIEventBindingType.Activating, (ctx) -> {
                    waypointClickHandler.accept("quest-marker");
                });
            }
            
            HyUIHud hud = builder.show();
            activeHuds.put(playerId, hud);
            return processedHtml;
            
        } catch (Exception e) {
            player.sendMessage("§cError displaying compass bar: " + e.getMessage());
            throw new RuntimeException("Failed to show compass bar", e);
        }
    }
    
    /**
     * Hide compass bar HUD for a player.
     * 
     * @param player Player to hide compass bar from
     */
    public void hideCompassBar(Player player) {
        HyUIHud hud = activeHuds.remove(player.getUUID());
        if (hud != null) {
            hud.remove();
        }
    }
    
    /**
     * Update compass bar data without recreating the HUD.
     * 
     * @param player Player to update
     * @param data New compass data
     */
    public void updateCompassBar(Player player, CompassData data) {
        HyUIHud hud = activeHuds.get(player.getUUID());
        if (hud != null) {
            String template = templateLoader.loadTemplate(COMPASS_BAR_TEMPLATE_PATH);
            String processedHtml = processTemplate(template, data);
            hud.updateHtml(processedHtml);
        } else {
            showCompassBar(player, data);
        }
    }
    
    /**
     * Process HYUIML template with compass data.
     * 
     * @param template Raw HYUIML template string
     * @param data Compass data for variable substitution
     * @return Processed HTML ready for rendering
     */
    private String processTemplate(String template, CompassData data) {
        TemplateProcessor processor = new TemplateProcessor();
        
        Map<String, Object> variables = new HashMap<>();
        variables.put("heading", data.heading());
        variables.put("trackedQuest", data.trackedQuest());
        variables.put("trackedWaypoint", data.trackedWaypoint());
        variables.put("nearbyPOIs", data.nearbyPOIs());
        
        processor.setVariable("compass", variables);
        return processor.process(template);
    }
    
    /**
     * Compass display data.
     * 
     * @param heading player's current heading in degrees (0-360)
     * @param trackedQuest currently tracked quest objective
     * @param trackedWaypoint player-set waypoint
     * @param nearbyPOIs nearby points of interest
     */
    public record CompassData(
        int heading,
        TrackedMarker trackedQuest,
        TrackedMarker trackedWaypoint,
        List<POIMarker> nearbyPOIs
    ) {}
    
    /**
     * Tracked marker (quest or waypoint).
     * 
     * @param name marker name
     * @param distance distance in blocks
     * @param direction relative direction in degrees
     * @param icon marker icon path
     */
    public record TrackedMarker(
        String name,
        int distance,
        int direction,
        String icon
    ) {}
    
    /**
     * Point of interest marker.
     * 
     * @param type POI type (village, dungeon, etc.)
     * @param direction relative direction in degrees
     * @param icon marker icon path
     */
    public record POIMarker(
        String type,
        int direction,
        String icon
    ) {}
}
